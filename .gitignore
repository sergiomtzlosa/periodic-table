# ─────────────────────────────────────────────────────────────────────────────
#  PeriodicTable for macOS
#  The Xcode project is generated by XcodeGen from project.yml, so it is a
#  build artefact: run `xcodegen generate` to recreate it (see AGENTS.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100
.AppleDouble
.LSOverride
Icon?
AGENTS.md

# ── Xcode ────────────────────────────────────────────────────────────────────
# The whole project is generated — never commit it.
*.xcodeproj/
*.xcworkspace/

# Per-user Xcode state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager (not used, but harmless to ignore)
.swiftpm/
.build/
Packages/
Package.resolved

# ── Build output ─────────────────────────────────────────────────────────────
build/
DerivedData/
*.o
*.d
*.hmap

# ── Python (the data generator) ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/

# ── Editors and misc ─────────────────────────────────────────────────────────
*.swp
*.swo
*~
.vscode/
.idea/
*.log
